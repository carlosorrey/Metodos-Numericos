      "source": [
        "from sympy import *\n",
        "\n",
        "x = symbols('x')\n",
        "i = symbols('i')\n",
        "\n",
        "p = Function('p')\n",
        "\n",
        "a = [0.7651977, -0.1837057, -0.1087334, 0.0658779, 0.0018254]\n",
        "\n",
        "xi = 1 + i*0.3\n",
        "\n",
        "p = a[0]\n",
        "\n",
        "for k in range(1, len(a)):\n",
        "    c = product(x - xi, (i, 0, k-1))\n",
        "    p = p + a[k]*c\n",
        "\n",
        "p = simplify(p)\n",
        "\n",
        "print(\"Polinomio:\")\n",
        "display(p)\n",
        "\n",
        "print(\"Polinomio desarrollado:\")\n",
        "display(expand(p))\n",
        "\n",
        "plot(p,\n",
        "     (x, 1, 2.2),\n",
        "     title=\"Polinomio de Newton\",\n",
        "     xlabel=\"x\",\n",
        "     ylabel=\"p(x)\")"
