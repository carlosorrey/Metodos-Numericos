    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Iteración       p_n             f(p_n)        Diferencia\n",
      "    0       0.7853981634          -7.829e-02          ---\n",
      "    1       0.7395361335       -7.549e-04       4.586e-02\n",
      "    2       0.7390851781       -7.513e-08       4.510e-04\n",
      "    3       0.7390851332       -7.772e-16       4.489e-08\n",
      "\n",
      "Raíz aproximada: 0.7390851332\n",
